#!/bin/sh

# 検証用偽 atrm (ハーネスの web root の bin/ へ配置)
# 偽スプールより脚本を削除する
# 本リポジトリの成果物ではなく tests/ 配下の治具

# e 返り値が0以外で停止
# u 未定義の変数参照で停止
set -eu

# ====== 変数の設定 ======
# ロケールの設定
export LC_ALL=C
export LANG=C

# GNU coreutilsの挙動をPOSIXに準拠
export POSIXLY_CORRECT=1

# 偽スプールの配置
SPOOL_DIR="${FAKE_AT_SPOOL:-/tmp/fake-at-spool}"
# ====== 変数の設定ここまで ======

mkdir -p "${SPOOL_DIR}"

printf '%s\n' "atrm ${*}" >> "${SPOOL_DIR}/calls.log"

for job_id in "${@}" ; do

	rm -f "${SPOOL_DIR}/${job_id}.sh"

done
