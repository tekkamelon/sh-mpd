#!/bin/sh

# 検証用偽 atq (ハーネスの web root の bin/ へ配置)
# 偽スプールの脚本を atq 形式で列挙する
# 本リポジトリの成果物ではなく tests/ 配下の治具

# e 返り値が0以外で停止
# u 未定義の変数参照で停止
set -eu

# ====== 変数の設定 ======
# ロケールの設定
export LC_ALL=C
export LANG=C

# GNU coreutilsの挙動をPOSIXに準拠
export POSIXLY_CORRECT=1

# 偽スプールの配置
SPOOL_DIR="${FAKE_AT_SPOOL:-/tmp/fake-at-spool}"
# ====== 変数の設定ここまで ======

# 他用途ジョブの混入(濾過の検証用。実 atq の行形式)
printf '99\t2026-01-02 00:00 a daemon\n'

if [ -d "${SPOOL_DIR}" ] ; then

	for job_file in "${SPOOL_DIR}"/*.sh ; do

		# 該当なしの場合は何も出さない
		if [ ! -f "${job_file}" ] ; then

			continue

		fi

		job_id="$(basename "${job_file}" .sh)"

		case "${job_id}" in

			""|*[!0-9]*)
				continue
				;;

		esac

		printf '%s\t2026-01-01 00:00 a fakedaemon\n' "${job_id}"

	done

fi
