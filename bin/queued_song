#!/usr/bin/awk -f

# 引数として -v mpc_current="${mpc_current}", -v post_name="play|del" が必要
#   mpc_current には再生中の楽曲パスを渡す("mpc current -f '%file%'")
#   ※bin/directory_tree と同じく楽曲パス同士で一致させる
# 入力は "楽曲パス" と "表示名" を Unit Separator(0x1F) で連結した行
#
# 入力例:
#   Album A/01.mp3<US>Artist - Title
#   http://radio.example/stream<US>
#
# ボタンの value には行番号ではなく楽曲パスを渡す

# HTML属性値と表示テキストの脱出
function html_escape(s) {

	gsub(/&/, "\\&amp;", s)
	gsub(/</, "\\&lt;", s)
	gsub(/>/, "\\&gt;", s)
	gsub(/"/, "\\&quot;", s)

	return s

}

BEGIN {

	# 区切り文字をUnit Separatorに指定
	FS = "\037"

}

{

	# 楽曲パスと表示名,表示名が空の場合はパスをそのまま表示
	path = $1
	display = ($2 == "" ? path : $2)

	# 空行は無視
	if (path == "") {

		next

	}

	# 属性値と表示名の脱出
	esc_path = html_escape(path)
	esc_display = html_escape(display)

	# 現在再生中の楽曲(表示名ではなく楽曲パスで一致させる)
	if (mpc_current == path) {

		if (post_name == "del") {

			print "<p><span id=current><input type=checkbox name=\"" post_name "\" value=\"" esc_path "\">" esc_display " <b>[Now Playing]</b></span></p>"

		} else {

			print "<p><span id=current><button class=now_playing name=\"" post_name "\" value=\"" esc_path "\">" esc_display "</button></span></p>"

		}

	# 削除用チェックボックス
	} else if (post_name == "del") {

		print "<p><input type=checkbox name=\"" post_name "\" value=\"" esc_path "\">" esc_display "</p>"

	# 再生用ボタン
	} else {

		print "<p><button name=\"" post_name "\" value=\"" esc_path "\">" esc_display "</button></p>"

	}

}
