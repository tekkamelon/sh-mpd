#!/usr/bin/awk -f

# mpd listall のパスを details/summary のツリーHTMLへ変換
# 引数: -v mpc_current="${mpc_current}" -v post_name="add" [-v open_all=1]
#
# 入力例:
#   ASMR/foo/01.mp3
#   ASMR/foo/02.mp3
#   chill_out/bar.m4a
#
# ボタンの value には行番号ではなく楽曲パスを渡す

# HTML属性値と表示テキストの脱出
function html_escape(s) {

	gsub(/&/, "\\&amp;", s)
	gsub(/</, "\\&lt;", s)
	gsub(/>/, "\\&gt;", s)
	gsub(/"/, "\\&quot;", s)

	return s

}

BEGIN {

	# 直前のディレクトリ階層数
	prev_depth = 0

}

{

	# パス本体
	path = $0

	# 空行は無視
	if (path == "") {

		next

	}

	# パスを "/" で分割
	n = split(path, parts, "/")

	# ファイル名とディレクトリ深度
	file_name = parts[n]
	depth = n - 1

	# 共通の親ディレクトリ深度を算出
	common = 0
	max_cmp = depth
	if (prev_depth < max_cmp) {

		max_cmp = prev_depth

	}

	i = 1
	while (i <= max_cmp) {

		if (parts[i] != prev_parts[i]) {

			break

		}

		common = i
		i = i + 1

	}

	# 分岐以降の details を閉じる
	i = prev_depth
	while (i > common) {

		print "</details>"
		i = i - 1

	}

	# 未出力のディレクトリを details で開く
	i = common + 1
	while (i <= depth) {

		if (open_all == 1) {

			print "<details class=\"dir-tree\" open>"

		} else {

			print "<details class=\"dir-tree\">"

		}

		# 当該階層までのフルパスを組み立て
		dir_path = parts[1]
		j = 2
		while (j <= i) {

			dir_path = dir_path "/" parts[j]
			j = j + 1

		}

		# ディレクトリ名と一括追加ボタン
		print "<summary><span class=\"dir-label\">" html_escape(parts[i]) "</span> <button type=\"submit\" class=\"add-dir\" name=\"addir\" value=\"" html_escape(dir_path) "\" title=\"Add all songs in this directory\" aria-label=\"Add all songs in this directory\">➕</button></summary>"
		prev_parts[i] = parts[i]
		i = i + 1

	}

	# 深い階層から戻った場合に備え,深さ以降のキャッシュを消す
	i = depth + 1
	while (i <= prev_depth) {

		prev_parts[i] = ""
		i = i + 1

	}

	prev_depth = depth

	# 属性値と表示名の脱出
	esc_path = html_escape(path)
	esc_name = html_escape(file_name)

	# 再生中楽曲の判定とボタン出力
	if (mpc_current == path && post_name != "del") {

		print "<p><span id=\"current\"><button class=\"now_playing\" name=\"" post_name "\" value=\"" esc_path "\">" esc_name "</button></span></p>"

	} else if (mpc_current == path && post_name == "del") {

		print "<p><span id=\"current\"><input type=\"checkbox\" name=\"" post_name "\" value=\"" esc_path "\">" esc_name " <b>[Now Playing]</b></span></p>"

	} else if (post_name == "play" || post_name == "add") {

		print "<p><button name=\"" post_name "\" value=\"" esc_path "\">" esc_name "</button></p>"

	} else if (post_name == "del") {

		print "<p><input type=\"checkbox\" name=\"" post_name "\" value=\"" esc_path "\">" esc_name "</p>"

	} else {

		print "<p>" esc_name "</p>"

	}

}

END {

	# 残っている details をすべて閉じる
	i = prev_depth
	while (i > 0) {

		print "</details>"
		i = i - 1

	}

}
