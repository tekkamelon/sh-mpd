#!/bin/sh

# shellcheck disable=SC2154

# カバーアートURLの生成(index.cgiとx_post.cgiで共用)
# 使用例: cover_url="$(coverart_url)"
#         環境変数 img_server_host, img_server_port で配信元を指定

# e 返り値が0以外で停止
# u 未定義の変数参照で停止
set -eu

# ====== 変数の設定 ======
# ロケールの設定
export LC_ALL=C
export LANG=C

# GNU coreutilsの挙動をPOSIXに準拠
export POSIXLY_CORRECT=1

# bin/urlencode へPATHを通す
tmp_path="$(cd "$(dirname "${0}")" && pwd)"
export PATH="${PATH}:${tmp_path}"
# ====== 変数の設定ここまで ======


# ====== 本体 ======
# 変数img_server_host,img_server_portの有無を確認
if [ -z "${img_server_host:-}" ] || [ -z "${img_server_port:-}" ] ; then

	printf ''

	exit 0

fi

# 現在の曲を変数に代入
current_song="$(mpc current -f "%file%")"

# 停止中は空を出力
if [ -z "${current_song}" ] ; then

	printf ''

	exit 0

fi

# 曲のパスを変数に代入
song_path="${current_song%/*}"

# パスのエンコード(区切りのスラッシュは保ち,セグメント単位でURLエスケープする)
# bin/urlencode はスラッシュもエンコードするため,区切りで分割してから適用する
# (空白や# ?を含むパスをそのままURLへ入れると,画像取得が失敗する)
encoded_path=""
rest_path="${song_path}"

while [ -n "${rest_path}" ] ; do

	segment="${rest_path%%/*}"

	case "${rest_path}" in

		*/*)

			rest_path="${rest_path#*/}"
			separator="/"

			;;

		*)

			rest_path=""
			separator=""

			;;

	esac

	encoded_path="${encoded_path}$(printf '%s' "${segment}" | urlencode)${separator}"

done

# カバーアートのURLを出力
printf 'http://%s:%s/%s/Folder.jpg' "${img_server_host}" "${img_server_port}" "${encoded_path}"
# ====== 本体ここまで ======
