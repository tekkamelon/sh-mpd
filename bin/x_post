#!/bin/sh

# shellcheck disable=SC1090,SC2154

# X API v2 への投稿クライアント(x_post.cgi から呼ぶ)
# 使用例: x_post -t "本文" [-i カバー画像URL]
#         資格情報とトークンファイルは環境変数より取る:
#           x_oauth2_client_id, x_oauth2_client_secret, x_token_file

# e 返り値が0以外で停止
# u 未定義の変数参照で停止
set -eu

# ====== 変数の設定 ======
# ロケールの設定
export LC_ALL=C
export LANG=C

# GNU coreutilsの挙動をPOSIXに準拠
export POSIXLY_CORRECT=1

# トークンファイル(環境変数 x_token_file で差し替え可能)
settings_dir="$(cd "$(dirname "${0}")/../cgi-bin/settings" 2>/dev/null && pwd)"
x_token_file="${x_token_file:-${settings_dir}/x_token.conf}"

# トークン更新用のロック(残骸は作成時刻で期限切れ)
lock_dir="${x_token_file}.lock"

# 一時ファイル(終了時に掃除)
tmp_file="${x_token_file}.tmp.$$"
cover_tmp="$(mktemp)"
lock_acquired=0

cleanup () {

	rm -f "${tmp_file}" "${cover_tmp}"

	if [ "${lock_acquired}" -eq 1 ] ; then

		rmdir "${lock_dir}" 2>/dev/null || true

	fi

}

trap cleanup EXIT
trap 'exit 1' INT TERM
# ====== 変数の設定ここまで ======


# ===== 関数の宣言 =====
# 使用方法の表示
print_usage () {

	cat <<- USAGE 1>&2
	使用例: x_post -t 本文 [-i カバー画像URL]

	引数: -t 本文        投稿する本文(必須)
	      -i カバーURL   本文に添付するカバー画像のURL(省略時は本文のみ)

	環境変数: x_oauth2_client_id, x_oauth2_client_secret, x_token_file
	USAGE

}

# JSON応答より文字列値を抽出(標準入力より読み込み)
# 引用符付きの値と数値のどちらにも対応する
json_value () {

	sed -n \
		-e 's/.*"'"${1}"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
		-e 's/.*"'"${1}"'"[[:space:]]*:[[:space:]]*\([^",}[:space:]]*\).*/\1/p'

}

# 資格情報の確認
check_credentials () {

	if [ -z "${x_oauth2_client_id:-}" ] || [ -z "${x_oauth2_client_secret:-}" ] ; then

		printf 'x_oauth2_client_id または x_oauth2_client_secret が未設定です\n' 1>&2

		exit 1

	fi

}

# トークンファイルより現在のトークンを読み込む
load_token () {

	if [ -f "${x_token_file}" ] ; then

		. "${x_token_file}"

	fi

	# 期限の値が数値でなければ期限切れ扱いにする
	case "${x_oauth2_expires_at:-0}" in

		''|*[!0-9]*)

			x_oauth2_expires_at="0"

			;;

	esac

}

# ロックの取得(60秒超の残骸は破棄,30秒で断念)
lock_acquire () {

	tries=0

	while ! mkdir "${lock_dir}" 2>/dev/null ; do

		if [ -n "$(find "${lock_dir}" -maxdepth 0 -mmin +1 2>/dev/null)" ] ; then

			rm -rf "${lock_dir}"

			continue

		fi

		tries=$((tries + 1))

		if [ "${tries}" -ge 30 ] ; then

			return 1

		fi

		sleep 1

	done

	lock_acquired=1

	return 0

}

# ロックの解放
lock_release () {

	rmdir "${lock_dir}" 2>/dev/null || true

	lock_acquired=0

}

# トークンを一時ファイル+mvで原子書き込み(ロック下で呼ぶ)
save_token () {

	# 引数: access_token, refresh_token, expires_at
	{
		printf 'x_oauth2_access_token="%s"\n' "${1}"
		printf 'x_oauth2_refresh_token="%s"\n' "${2}"
		printf 'x_oauth2_expires_at="%s"\n' "${3}"
	} > "${tmp_file}"

	chmod 600 "${tmp_file}"

	mv -f "${tmp_file}" "${x_token_file}"

}

# トークンの更新(応答はローテーションするため新しいrefresh_tokenも保存)
# 戻り値: 0なら access_token, new_refresh_token, expires_at を設定
refresh_request () {

	# 引数: 現在のrefresh_token
	token_response="$(curl -sS -m 15 -X POST https://api.x.com/2/oauth2/token \
		-d "grant_type=refresh_token" \
		-d "refresh_token=${1}" \
		-d "client_id=${x_oauth2_client_id}" \
		-d "client_secret=${x_oauth2_client_secret}")"

	access_token="$(printf '%s' "${token_response}" | json_value access_token)"

	# 応答に新しいrefresh_tokenが無ければ既存のものを使う
	new_refresh_token="$(printf '%s' "${token_response}" | json_value refresh_token)"

	if [ -z "${new_refresh_token}" ] ; then

		new_refresh_token="${1}"

	fi

	expires_in="$(printf '%s' "${token_response}" | json_value expires_in)"

	if [ -z "${access_token}" ] ; then

		return 1

	fi

	expires_at="$(( $(date +%s) + ${expires_in:-0} ))"

	return 0

}

# 期限切れのトークンを更新する(ローテーションの並走を防ぐため更新全体をロック下で行う)
ensure_token () {

	# トークンファイルが無ければ初回設定を案内して中断
	if [ ! -f "${x_token_file}" ] ; then

		printf 'トークンファイルがありません。bin/x_oauth2 で初回設定を行ってください\n' 1>&2

		exit 1

	fi

	load_token

	# 期限内なら更新しない
	if [ -n "${x_oauth2_access_token:-}" ] && [ "${x_oauth2_expires_at}" -gt "$(date +%s)" ] ; then

		return 0

	fi

	if ! lock_acquire ; then

		printf 'ロックの取得に失敗しました: %s\n' "${lock_dir}" 1>&2

		exit 1

	fi

	# 待機中に他の更新が済んでいる可能性があるため読み直す
	load_token

	if [ -n "${x_oauth2_access_token:-}" ] && [ "${x_oauth2_expires_at}" -gt "$(date +%s)" ] ; then

		lock_release

		return 0

	fi

	if [ -z "${x_oauth2_refresh_token:-}" ] || ! refresh_request "${x_oauth2_refresh_token}" ; then

		lock_release

		printf 'トークン更新に失敗しました。再認可が必要です(bin/x_oauth2 setup)。API応答:\n%s\n' "${token_response}" 1>&2

		exit 1

	fi

	save_token "${access_token}" "${new_refresh_token}" "${expires_at}"

	# 以降のAPI呼び出しは更新後のトークンを使う
	x_oauth2_access_token="${access_token}"

	lock_release

}

# カバー画像の取得(成功時は cover_tmp へ保存し0を返す,失敗時は本文のみで投稿させる)
fetch_cover () {

	# 引数: カバー画像URL
	if ! curl -sS -f -m 10 -o "${cover_tmp}" "${1}" ; then

		printf 'カバー画像の取得に失敗しました(%s)。本文のみで投稿します\n' "${1}" 1>&2

		return 1

	fi

	if [ ! -s "${cover_tmp}" ] ; then

		printf 'カバー画像が空でした(%s)。本文のみで投稿します\n' "${1}" 1>&2

		return 1

	fi

	return 0

}

# 拡張子よりMIMEを判定(既定はimage/jpeg)
cover_mime () {

	case "${1}" in

		*.png)

			printf 'image/png'

			;;

		*.gif)

			printf 'image/gif'

			;;

		*.webp)

			printf 'image/webp'

			;;

		*)

			printf 'image/jpeg'

			;;

	esac

}
# ===== 関数の宣言ここまで ======


# ====== 本体 ======
# 引数の解析
share_text=""
cover_url=""

while [ "${#}" -gt 0 ] ; do

	case "${1}" in

		-t)

			if [ "${#}" -lt 2 ] ; then

				print_usage

				exit 1

			fi

			share_text="${2}"
			shift 2

			;;

		-i)

			if [ "${#}" -lt 2 ] ; then

				print_usage

				exit 1

			fi

			cover_url="${2}"
			shift 2

			;;

		-h|--help)

			print_usage

			exit 0

			;;

		*)

			print_usage

			exit 1

			;;

	esac

done

if [ -z "${share_text}" ] ; then

	printf '本文が指定されていません(-t)\n' 1>&2

	exit 1

fi

check_credentials

ensure_token

# 投稿本文のJSONエスケープ(引用符とバックスラッシュ,制御文字)
json_text="$(printf '%s' "${share_text}" |
	sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' |
	tr -d '\000-\037')"

media_id=""

# カバー画像の取得とアップロード
if [ -n "${cover_url}" ] && fetch_cover "${cover_url}" ; then

	upload_status=0
	upload_response="$(curl -sS -m 30 -X POST \
		-H "Authorization: Bearer ${x_oauth2_access_token}" \
		-F "media_category=tweet_image" \
		-F "media=@${cover_tmp};type=$(cover_mime "${cover_url}")" \
		https://api.x.com/2/media/upload)" || upload_status=1

	media_id="$(printf '%s' "${upload_response}" | json_value id)"

	if [ "${upload_status}" -ne 0 ] || [ -z "${media_id}" ] ; then

		printf 'media upload に失敗しました。投稿を行いません。API応答:\n%s\n' "${upload_response}" 1>&2

		exit 1

	fi

fi

# 投稿本文の組み立て
if [ -n "${media_id}" ] ; then

	tweet_body="{\"text\":\"${json_text}\",\"media\":{\"media_ids\":[\"${media_id}\"]}}"

else

	tweet_body="{\"text\":\"${json_text}\"}"

fi

# 投稿
tweet_status=0
tweet_response="$(curl -sS -m 30 -X POST \
	-H "Authorization: Bearer ${x_oauth2_access_token}" \
	-H "Content-type: application/json" \
	-d "${tweet_body}" \
	https://api.x.com/2/tweets)" || tweet_status=1

tweet_id="$(printf '%s' "${tweet_response}" | json_value id)"

if [ "${tweet_status}" -ne 0 ] || [ -z "${tweet_id}" ] ; then

	printf '投稿に失敗しました。API応答:\n%s\n' "${tweet_response}" 1>&2

	exit 1

fi

# 成功時は投稿応答本文を標準出力へ
printf '%s' "${tweet_response}"
# ====== 本体ここまで ======
